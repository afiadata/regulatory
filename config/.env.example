# Copy this file to .env at the repo root and fill in real values.
# Never commit .env to version control.

# ── Postgres ─────────────────────────────────────────────────────────────────
# Docker Compose dev default (matches docker-compose.yml):
DATABASE_URL=postgresql://regulatory:regulatory@localhost:5432/regulatory

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Default model for PDF extraction (cost-efficient default):
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── openFDA ───────────────────────────────────────────────────────────────────
# Optional — raises rate limit from 240 req/min to 120k/day.
# Register at: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# ── Modal ─────────────────────────────────────────────────────────────────────
# Set automatically by `modal token set`. No manual config needed here.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
